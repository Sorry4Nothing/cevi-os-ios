// Umgebung: Prod
#include "Base.xcconfig"
#include? "Secrets.xcconfig"

APP_BUNDLE_IDENTIFIER = $(APP_BUNDLE_ID_PREFIX).$(APP_BUNDLE_BASENAME)
INFOPLIST_KEY_CFBundleDisplayName = Cevi OS
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
SWIFT_ACTIVE_COMPILATION_CONDITIONS = PROD $(inherited)
API_BASE_URL = $(API_BASE_URL_PROD)
// App Attest (not in Dev: a free Personal Team cannot sign this entitlement).
CODE_SIGN_ENTITLEMENTS = Config/CeviOS.entitlements

APP_GROUP_ID = group.$(APP_BUNDLE_IDENTIFIER)
WIDGET_ENTITLEMENTS = Config/CeviOSWidgets.entitlements
