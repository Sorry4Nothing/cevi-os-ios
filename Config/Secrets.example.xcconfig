// Vorlage. Nach Config/Secrets.xcconfig kopieren (die Datei wird nicht eingecheckt) und echte Werte eintragen.
// In URLs «:/$()/» statt «://» schreiben, sonst gilt der Rest der Zeile als Kommentar.
API_BASE_URL_DEV = https:/$()/api.example.org
API_BASE_URL_INT = https:/$()/api.example.org
API_BASE_URL_PROD = https:/$()/api.example.org
